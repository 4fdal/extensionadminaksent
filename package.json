{
  "name": "extension-admin-aksent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:sql:wasm && vite",
    "build": "vite build",
    "build-tsc": "tsc && vite build",
    "preview": "vite preview",
    "copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm public/assets",
    "build:web": "npm run copy:sql:wasm && npm run build",
    "migration:generate": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:generate ./src/databases/migrations/Init -d ./src/databases/data-source.cli.ts",
    "migration:run": "node --loader ts-node/esm ./node_modules/typeorm/cli.js migration:run -d ./src/databases/data-source.cli.ts",
    "postinstall": "node ./scripts/modify-typeorm.cjs",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "build:android": "ionic cap sync android && ionic cap run android ",
    "dev:android": "ionic cap sync android && ionic cap run android -l --external --verbose  ",
    "emulator": "emulator -avd Pixel_8_Pro",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.0.2",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "8.0.0",
    "@capacitor/toast": "^8.0.1",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@capgo/capacitor-share-target": "^8.0.20",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@ljharb/tsconfig": "^0.3.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/cordova": "^11.0.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "clsx": "^2.1.1",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "date-fns": "4.1.0",
    "framer-motion": "^12.38.0",
    "ionicons": "^7.4.0",
    "lucide-react": "^1.14.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-window": "^2.2.7",
    "reflect-metadata": "^0.2.2",
    "sqlite": "^5.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.1",
    "copyfiles": "^2.4.1",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "sqlite3": "^5.1.7",
    "terser": "^5.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "unplugin-swc": "^1.5.9",
    "vite": "^5.0.0",
    "vitest": "^0.34.6"
  },
  "description": "An Ionic project"
}
